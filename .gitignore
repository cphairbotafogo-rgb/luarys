# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Resultado de execucao dos scripts de conferencia: backup de limpeza e lista de
# pareamento. Levam nome de cliente e valor dentro, e servem para desfazer uma
# operacao daquele dia — nao para virar historico do repositorio.
scripts/conferencia/backup-limpeza-*.json
scripts/conferencia/pareamento-*.json
scripts/conferencia/backup-nbs-*.json
scripts/conferencia/backup-precos-*.json
# Estes dois levam dado de cliente e login dentro (salao inteiro, cadastro de
# clientes, e-mail de usuario). Sao a unica volta de uma exclusao, e por isso
# devem ficar na maquina de quem executou — nunca no repositorio.
scripts/conferencia/backup-saloes-*.json
scripts/conferencia/backup-logins-*.json

# Documento gerado para a contabilidade do salao: leva CNPJ, inscricao estadual
# e municipal dentro. Recriavel com scripts/conferencia/gerar-pdf-contabilidade.mjs,
# e sempre com os valores do dia — versao guardada no repositorio so envelheceria.
perguntas-contabilidade.pdf

# Zip gerado para auditoria externa — recriavel com scripts/conferencia/empacotar-codigo.mjs
luarys-codigo.zip
